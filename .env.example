# Optional: Formspree form ID for real contact-form delivery. Without it the form opens the visitor's email app (honest mailto fallback).
VITE_FORMSPREE_ID=
# Set AFTER your real deployment, e.g. https://your-domain.vercel.app (no trailing slash).
# Used for canonical, og:url, og:image, robots.txt and sitemap.xml. If empty, those are omitted.
VITE_SITE_URL=
